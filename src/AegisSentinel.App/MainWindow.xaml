<Window x:Class="AegisSentinel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AegisSentinel Enterprise - 윈도우 통합 EDR · 랜섬웨어 · 공급망 보안 센터"
        Height="820" Width="1340" MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="#080D15"
        Foreground="#F1F5F9">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT NAVIGATION SIDEBAR -->
        <Border Grid.Column="0" Background="#0D1420" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="16,18,16,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="9" Background="#0F2942" BorderBrush="#38BDF8" BorderThickness="1.5" Margin="0,0,10,0">
                            <TextBlock Text="🛡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="AegisSentinel" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock x:Name="AppEditionSubtitleText" Text="Enterprise Guard v7.0" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="StatusBadgeBorder" Background="#064E3B" CornerRadius="7" Padding="10,6" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock x:Name="StatusBadgeText" Text="실시간 9중 방어 작동 중" Foreground="#6EE7B7" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="TelemetryBadgeText" Text="유저 모드" Foreground="#A7F3D0" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Bottom Sidebar Actions -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,10,12,14">
                    <Border Background="#121B29" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="OS 보안 점수" Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock x:Name="SidebarScoreText" Text="--/100" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="Bold" FontSize="12"/>
                            </DockPanel>
                            <ProgressBar x:Name="SidebarScoreBar" Height="6" Minimum="0" Maximum="100" Value="0" Margin="0,6,0,0" Background="#1E293B" Foreground="#10B981" BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ElevateButton" Content="관리자 승격 (ETW 커널 켜기)" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6" Click="OnElevateClick"/>
                    <Button x:Name="ToggleEngineButton" Content="감시 일시중지" Style="{StaticResource SecondaryButton}" Click="OnToggleEngineClick"/>
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel Margin="0,4,0,0">
                    <RadioButton x:Name="NavDashboard" Content="🏠  커맨드 센터" Style="{StaticResource NavButton}" IsChecked="True" Tag="Dashboard" Checked="OnNavSelected"/>
                    <RadioButton x:Name="NavThreats" Content="⚡  실시간 위협 피드" Style="{StaticResource NavButton}" Tag="Threats" Checked="OnNavSelected"/>
                    <RadioButton x:Name="NavScanner" Content="🔍  바이러스 검사 · MZK 치료" Style="{StaticResource NavButton}" Tag="Scanner" Checked="OnNavSelected"/>
                    <RadioButton x:Name="NavNetwork" Content="🌐  네트워크 · 방화벽" Style="{StaticResource NavButton}" Tag="Network" Checked="OnNavSelected"/>
                    <RadioButton x:Name="NavPersistence" Content="🧬  지속성 (Autoruns)" Style="{StaticResource NavButton}" Tag="Persistence" Checked="OnNavSelected"/>
                    <RadioButton x:Name="NavVault" Content="🗄️  복구 금고 · 격리소" Style="{StaticResource NavButton}" Tag="Vault" Checked="OnNavSelected"/>
                    <RadioButton x:Name="NavSandbox" Content="📦  격리 실행기 (Sandbox)" Style="{StaticResource NavButton}" Tag="Sandbox" Checked="OnNavSelected"/>
                    <RadioButton x:Name="NavHardening" Content="⚙️  커널 보안 · IOC 정책" Style="{StaticResource NavButton}" Tag="Hardening" Checked="OnNavSelected"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Action Bar -->
            <Border Grid.Row="0" Background="#0D1420" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PageHeaderTitle" Grid.Column="0" Text="커맨드 센터" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock x:Name="PageHeaderSubtitle" Grid.Column="1" Text=" — 9중 엔드포인트 방어 실시간 현황" FontSize="12.5" Foreground="#94A3B8"
                                   VerticalAlignment="Center" Margin="6,2,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Grid>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="ModeComboBox" Width="188" Margin="0,0,8,0" Style="{StaticResource DarkComboBox}"
                                  SelectionChanged="OnProtectionModeChanged">
                            <ComboBoxItem Content="균형 모드 (스마트 저마찰)" Tag="Balanced"/>
                            <ComboBoxItem Content="엄격 모드 (미서명 자동 차단)" Tag="Strict"/>
                            <ComboBoxItem Content="탐지 전용 (로그만 기록)" Tag="MonitorOnly"/>
                        </ComboBox>
                        <Button x:Name="HeaderQuickScanBtn" Content="MZK 검사" Style="{StaticResource SuccessButton}" Margin="0,0,6,0" Click="OnQuickScanFromHeaderClick"/>
                        <Button Content="15대 자체 검증" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Click="OnRunSelfTestClick"/>
                        <Button Content="ATT&amp;CK(JSON)" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="OnExportMitreLayerClick"/>
                        <Button Content="리포트(HTML)" Style="{StaticResource SecondaryButton}" Click="OnExportHtmlReportClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- VIEWS CONTAINER -->
            <Grid Grid.Row="1" Margin="18">

                <!-- 1. DASHBOARD VIEW -->
                <ScrollViewer x:Name="ViewDashboard" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Hero Posture Banner -->
                        <Border Background="#121B29" BorderBrush="#24334A" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="스마트 저마찰 엔드포인트 통합 방어" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="단일 약한 신호에는 방해 팝업을 띄우지 않고 백그라운드 상관분석으로 추적하며, 공급망 공격·자격증명 유출·랜섬웨어 암호화·파일리스 인젝션 확정 시 즉시 프로세스를 동결합니다."
                                               Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,5,16,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="LowFrictionCheckBox" Content="스마트 저마찰 상관분석 모드 (일상 제약 최소화)" Foreground="#E2E8F0" FontWeight="SemiBold"
                                                  Checked="OnLowFrictionToggled" Unchecked="OnLowFrictionToggled"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock x:Name="DashboardScoreBigText" Text="-- / 100" FontSize="28" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="DashboardEventSummaryText" Text="기록된 이벤트: 0건 | 복구금고: 0개" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 9 Active Defense Engines Grid -->
                        <UniformGrid Columns="3" Margin="0,0,0,14">
                            <Border Background="#121B29" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="1. 공급망 · 다단계 계보 · 해시 변조" FontWeight="Bold" Foreground="#38BDF8" FontSize="12"/>
                                    <TextBlock x:Name="CardSupplyChainStatus" Text="활성" Foreground="#10B981" FontSize="16" FontWeight="Bold" Margin="0,4,0,2"/>
                                    <TextBlock Text="런처 다단계 자식 추적 + 승인 바이너리 SHA-256 변조 탐지" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#121B29" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="2. 랜섬웨어 · 엔트로피 · 카나리" FontWeight="Bold" Foreground="#38BDF8" FontSize="12"/>
                                    <TextBlock x:Name="CardRansomwareStatus" Text="활성" Foreground="#10B981" FontSize="16" FontWeight="Bold" Margin="0,4,0,2"/>
                                    <TextBlock Text="미끼 파일 + 매직헤더 파괴/고엔트로피 암호화 즉시 동결" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#121B29" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="3. 네트워크 C2 · DNS · WFP 방화벽" FontWeight="Bold" Foreground="#38BDF8" FontSize="12"/>
                                    <TextBlock x:Name="CardNetworkStatus" Text="활성" Foreground="#10B981" FontSize="16" FontWeight="Bold" Margin="0,4,0,2"/>
                                    <TextBlock Text="IOC 도메인/IP 차단 · 자격증명 유출 체인 차단" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#121B29" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="4. 파일리스 스크립트 (PS 4104)" FontWeight="Bold" Foreground="#38BDF8" FontSize="12"/>
                                    <TextBlock x:Name="CardFilelessStatus" Text="활성" Foreground="#10B981" FontSize="16" FontWeight="Bold" Margin="0,4,0,2"/>
                                    <TextBlock Text="메모리 AMSI 우회 · 리플렉션 로드 · Defender 이벤트 연동" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#121B29" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="5. 메모리 인젝션 (Private RWX)" FontWeight="Bold" Foreground="#38BDF8" FontSize="12"/>
                                    <TextBlock x:Name="CardMemoryStatus" Text="활성" Foreground="#10B981" FontSize="16" FontWeight="Bold" Margin="0,4,0,2"/>
                                    <TextBlock Text="VirtualQueryEx 기반 비-JIT 프로세스 RWX 셸코드 감시" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#121B29" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="6. 자격증명 · 브라우저 DLL 가드" FontWeight="Bold" Foreground="#38BDF8" FontSize="12"/>
                                    <TextBlock x:Name="CardCredentialStatus" Text="활성" Foreground="#10B981" FontSize="16" FontWeight="Bold" Margin="0,4,0,2"/>
                                    <TextBlock Text="Chrome/Edge DLL 하이재킹 · 쿠키/.ssh/.aws 보호" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#121B29" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="7. 7종 지속성 (Autoruns)" FontWeight="Bold" Foreground="#38BDF8" FontSize="12"/>
                                    <TextBlock x:Name="CardPersistenceStatus" Text="활성" Foreground="#10B981" FontSize="16" FontWeight="Bold" Margin="0,4,0,2"/>
                                    <TextBlock Text="Run · IFEO · Winlogon · 작업스케줄 · WMI · 브라우저 정책" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#121B29" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="8. 다운로드(MotW) · USB 가드" FontWeight="Bold" Foreground="#38BDF8" FontSize="12"/>
                                    <TextBlock x:Name="CardDownloadUsbStatus" Text="활성" Foreground="#10B981" FontSize="16" FontWeight="Bold" Margin="0,4,0,2"/>
                                    <TextBlock Text="다운로드 즉시 PE 정적 분석 + USB autorun/드로퍼 검사" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#121B29" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="9. 자동 복구 금고 · 커널 ASR" FontWeight="Bold" Foreground="#38BDF8" FontSize="12"/>
                                    <TextBlock x:Name="CardVaultStatus" Text="활성" Foreground="#10B981" FontSize="16" FontWeight="Bold" Margin="0,4,0,2"/>
                                    <TextBlock Text="안티-포이즈닝 문서 백업 + Defender CFA/ASR 커널 연동" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Recent Alerts Quick Preview -->
                        <Border Background="#121B29" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="최근 탐지된 보안 이벤트 (상위 8건)" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Content="전체 피드 보기" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="10,4" Click="OnGoToThreatsClick"/>
                                </DockPanel>
                                <ListView x:Name="DashboardRecentListView" Height="180" Background="#080D15" BorderBrush="#1E293B" Foreground="#E2E8F0">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="시각" Width="75" DisplayMemberBinding="{Binding TimeText}"/>
                                            <GridViewColumn Header="위험도" Width="62" DisplayMemberBinding="{Binding RiskText}"/>
                                            <GridViewColumn Header="MITRE" Width="85" DisplayMemberBinding="{Binding MitreText}"/>
                                            <GridViewColumn Header="프로세스" Width="150" DisplayMemberBinding="{Binding ProcessText}"/>
                                            <GridViewColumn Header="제목 / 상세" Width="520" DisplayMemberBinding="{Binding SummaryText}"/>
                                            <GridViewColumn Header="조치" Width="95" DisplayMemberBinding="{Binding ActionText}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2. LIVE THREATS VIEW -->
                <Grid x:Name="ViewThreats" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="155"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="SeverityFilterCombo" Width="130" Margin="0,0,8,0" Style="{StaticResource DarkComboBox}" SelectionChanged="OnEventFilterChanged">
                                <ComboBoxItem Content="전체 심각도" Tag="ALL" IsSelected="True"/>
                                <ComboBoxItem Content="CRITICAL" Tag="Critical"/>
                                <ComboBoxItem Content="HIGH 이상" Tag="High"/>
                                <ComboBoxItem Content="MEDIUM 이상" Tag="Medium"/>
                            </ComboBox>
                            <TextBlock Text="검색:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0,6,0"/>
                            <TextBox x:Name="EventSearchBox" Width="220" Background="#121B29" Foreground="#F1F5F9" BorderBrush="#334155" Padding="8,6" TextChanged="OnEventSearchChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="WFP 방화벽 차단" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="OnFirewallBlockSelectedEventClick"/>
                            <Button Content="종료 및 격리" Style="{StaticResource DangerButton}" Margin="0,0,6,0" Click="OnKillSelectedEventClick"/>
                            <Button Content="해시 신뢰 등록/재개" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Click="OnResumeSelectedEventClick"/>
                            <Button Content="지우기" Style="{StaticResource SecondaryButton}" Click="OnClearEventsClick"/>
                        </StackPanel>
                    </Grid>

                    <ListView x:Name="EventsListView" Grid.Row="1" Background="#0D1420" BorderBrush="#24334A" Foreground="#E2E8F0" SelectionChanged="OnEventSelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="시각" Width="75" DisplayMemberBinding="{Binding TimeText}"/>
                                <GridViewColumn Header="위험도" Width="60" DisplayMemberBinding="{Binding RiskText}"/>
                                <GridViewColumn Header="심각도" Width="72" DisplayMemberBinding="{Binding SeverityText}"/>
                                <GridViewColumn Header="MITRE" Width="82" DisplayMemberBinding="{Binding MitreText}"/>
                                <GridViewColumn Header="분류" Width="105" DisplayMemberBinding="{Binding CategoryText}"/>
                                <GridViewColumn Header="조치" Width="90" DisplayMemberBinding="{Binding ActionText}"/>
                                <GridViewColumn Header="프로세스(PID)" Width="140" DisplayMemberBinding="{Binding ProcessText}"/>
                                <GridViewColumn Header="제목 / 대상 / 원격" Width="310" DisplayMemberBinding="{Binding SummaryText}"/>
                                <GridViewColumn Header="서명 상태" Width="145" DisplayMemberBinding="{Binding SignatureText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="2" Background="#121B29" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="EventInspectorText" Text="이벤트를 선택하면 MITRE ATT&amp;CK 전술, 프로세스 실행 계보, 위험 신호, 명령줄 등 포렌식 상세 정보가 표시됩니다."
                                       FontFamily="Consolas" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 3. ANTIVIRUS & MZK DEEP SCANNER + 1-CLICK CURE VIEW -->
                <Grid x:Name="ViewScanner" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#121B29" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="MZK급 6단계 바이러스 정밀 검사 · 하이브리드 백신 · 원클릭 안전 치료" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="프로세스/메모리 · 시작프로그램/IFEO/Winlogon/서비스 · 브라우저 하이재킹 · HOSTS/프록시/Defender예외 · YARA/EICAR/PE/스크립트 · Defender 글로벌 DB 교차검증을 한 번에 수행하고 안전하게 치료합니다."
                                               Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                </StackPanel>
                            </DockPanel>
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="MzkDeepScanBtn" Content="🛡️ MZK 6단계 정밀 검사 (추천)" Style="{StaticResource SuccessButton}" Margin="0,0,8,6" Click="OnRunMzkDeepScanClick"/>
                                <Button x:Name="QuickScanBtn" Content="⚡ 빠른 검사" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" Click="OnRunQuickScanClick"/>
                                <Button x:Name="FullScanBtn" Content="💽 전체 PC 정밀 검사" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Click="OnRunFullSystemScanClick"/>
                                <Button x:Name="FolderScanBtn" Content="📁 폴더 검사..." Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Click="OnScanFolderClick"/>
                                <Button x:Name="FileScanBtn" Content="📄 단일 파일 검사..." Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Click="OnScanSingleFileClick"/>
                                <Button x:Name="UpdateVirusDbBtn" Content="🌐 바이러스 DB 업데이트 (~25만+)" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" Click="OnUpdateVirusDbClick"/>
                                <Button x:Name="CancelScanBtn" Content="⏹ 검사 중지" Style="{StaticResource DangerButton}" Margin="0,0,8,6" IsEnabled="False" Click="OnCancelScanClick"/>
                            </WrapPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="DefenderCrossCheckBox" Grid.Column="0" Content="Windows Defender 글로벌 시그니처 DB 교차 검증 포함 (MpCmdRun 하이브리드)" IsChecked="True" Foreground="#CBD5E1" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="VirusDbStatusText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="바이러스 DB 로드 중..." Foreground="#34D399" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </Grid>
                            <ProgressBar x:Name="ScanProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Background="#1E293B" Foreground="#10B981" BorderThickness="0" Margin="0,2,0,6"/>
                            <TextBlock x:Name="ScanStatusText" Text="검사 대기 중 — [MZK 6단계 정밀 검사]를 눌러 PC 전체의 악성코드·하이재킹·변조 흔적을 점검하세요." Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ScanStageDetailText" Text="" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <ListView x:Name="ScanFindingsListView" Grid.Row="1" Background="#0D1420" BorderBrush="#24334A" Foreground="#E2E8F0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="선택" Width="46">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanCure}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="위험도" Width="62" DisplayMemberBinding="{Binding RiskText}"/>
                                <GridViewColumn Header="심각도" Width="72" DisplayMemberBinding="{Binding SeverityText}"/>
                                <GridViewColumn Header="탐지명 (AV / MZK)" Width="210" DisplayMemberBinding="{Binding ThreatName}"/>
                                <GridViewColumn Header="분류" Width="135" DisplayMemberBinding="{Binding CategoryLabel}"/>
                                <GridViewColumn Header="대상 경로 / 레지스트리" Width="260" DisplayMemberBinding="{Binding TargetPath}"/>
                                <GridViewColumn Header="탐지 상세 사유" Width="280" DisplayMemberBinding="{Binding Description}"/>
                                <GridViewColumn Header="상태" Width="92" DisplayMemberBinding="{Binding StatusText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SelectAllThreatsBtn" Content="치료 권장 전체 선택" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnSelectAllThreatsClick"/>
                            <Button x:Name="UnselectAllThreatsBtn" Content="선택 해제" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnUnselectAllThreatsClick"/>
                            <Button x:Name="VirusTotalQueryBtn" Content="선택 파일 VirusTotal 조회" Style="{StaticResource SecondaryButton}" Click="OnQueryVirusTotalClick"/>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CureSelectedBtn" Content="💊 선택 위협 일괄 치료 및 복구 (MZK Cure)" Style="{StaticResource DangerButton}" Click="OnCureSelectedThreatsClick"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 4. NETWORK & FIREWALL VIEW -->
                <Grid x:Name="ViewNetwork" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="220"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#121B29" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="실시간 외부 네트워크 연결 (DNS 도메인 상관분석)" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button Content="연결 새로고침" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnRefreshNetworkClick"/>
                                    <Button Content="선택 앱 커널 방화벽 차단(WFP)" Style="{StaticResource DangerButton}" Click="OnBlockSelectedConnectionClick"/>
                                </StackPanel>
                            </DockPanel>
                            <ListView x:Name="ConnectionsListView" Grid.Row="1" Background="#080D15" BorderBrush="#1E293B" Foreground="#E2E8F0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="PID" Width="65" DisplayMemberBinding="{Binding ProcessId}"/>
                                        <GridViewColumn Header="프로세스" Width="150" DisplayMemberBinding="{Binding ProcessName}"/>
                                        <GridViewColumn Header="외부 IP:포트" Width="175" DisplayMemberBinding="{Binding EndpointText}"/>
                                        <GridViewColumn Header="DNS 도메인" Width="210" DisplayMemberBinding="{Binding RemoteDomain}"/>
                                        <GridViewColumn Header="위험도" Width="65" DisplayMemberBinding="{Binding RiskScore}"/>
                                        <GridViewColumn Header="서명 상태" Width="175" DisplayMemberBinding="{Binding SignatureLabel}"/>
                                        <GridViewColumn Header="실행 경로" Width="210" DisplayMemberBinding="{Binding ProcessPath}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#121B29" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="AegisSentinel WFP 커널 방화벽 차단 규칙" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button Content="규칙 새로고침" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnRefreshFirewallRulesClick"/>
                                    <Button Content="선택 규칙 차단 해제" Style="{StaticResource PrimaryButton}" Click="OnUnblockFirewallRuleClick"/>
                                </StackPanel>
                            </DockPanel>
                            <ListView x:Name="FirewallRulesListView" Grid.Row="1" Background="#080D15" BorderBrush="#1E293B" Foreground="#E2E8F0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="규칙 이름" Width="260" DisplayMemberBinding="{Binding RuleName}"/>
                                        <GridViewColumn Header="차단된 프로그램" Width="560" DisplayMemberBinding="{Binding ProgramPath}"/>
                                        <GridViewColumn Header="방향" Width="90" DisplayMemberBinding="{Binding Direction}"/>
                                        <GridViewColumn Header="동작" Width="90" DisplayMemberBinding="{Binding Action}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 5. PERSISTENCE (AUTORUNS) VIEW -->
                <Grid x:Name="ViewPersistence" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="7종 Windows 지속성 (Autoruns) 전체 감사" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="Run/RunOnce · 시작프로그램 · Winlogon · IFEO Debugger · 브라우저 강제확장 정책 · 작업스케줄러 · WMI 파일리스 구독을 검사합니다."
                                       Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="지속성 항목 새로 스캔" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="OnRefreshPersistenceClick"/>
                            <Button Content="선택 항목 제거/롤백" Style="{StaticResource DangerButton}" Click="OnRemovePersistenceEntryClick"/>
                        </StackPanel>
                    </Grid>

                    <ListView x:Name="PersistenceListView" Grid.Row="1" Background="#0D1420" BorderBrush="#24334A" Foreground="#E2E8F0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="분류" Width="130" DisplayMemberBinding="{Binding Category}"/>
                                <GridViewColumn Header="이름" Width="170" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="서명 상태" Width="180" DisplayMemberBinding="{Binding SignatureText}"/>
                                <GridViewColumn Header="명령 / 값" Width="360" DisplayMemberBinding="{Binding Value}"/>
                                <GridViewColumn Header="위치" Width="210" DisplayMemberBinding="{Binding SourceLocation}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <!-- 6. VAULT & QUARANTINE VIEW -->
                <Grid x:Name="ViewVault" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Recovery Vault -->
                    <Border Grid.Column="0" Background="#121B29" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="랜섬웨어 자동 복구 금고" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Content="지금 스냅샷 갱신" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Padding="10,5" Click="OnSnapshotNowClick"/>
                            </DockPanel>
                            <ListView x:Name="VaultListView" Grid.Row="1" Background="#080D15" BorderBrush="#1E293B" Foreground="#E2E8F0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="백업 시각" Width="120" DisplayMemberBinding="{Binding TimeText}"/>
                                        <GridViewColumn Header="원본 경로" Width="270" DisplayMemberBinding="{Binding OriginalPath}"/>
                                        <GridViewColumn Header="크기" Width="75" DisplayMemberBinding="{Binding SizeText}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <Button Grid.Row="2" Content="선택 파일 깨끗한 원본으로 복구" Style="{StaticResource SuccessButton}" Margin="0,10,0,0" HorizontalAlignment="Right" Click="OnRestoreVaultFileClick"/>
                        </Grid>
                    </Border>

                    <!-- Quarantine -->
                    <Border Grid.Column="1" Background="#121B29" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="위협 격리소 (Quarantine)" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Content="새로고침" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="10,5" Click="OnRefreshQuarantineClick"/>
                            </DockPanel>
                            <ListView x:Name="QuarantineListView" Grid.Row="1" Background="#080D15" BorderBrush="#1E293B" Foreground="#E2E8F0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="격리 시각" Width="120" DisplayMemberBinding="{Binding TimeText}"/>
                                        <GridViewColumn Header="원본 경로" Width="220" DisplayMemberBinding="{Binding OriginalPath}"/>
                                        <GridViewColumn Header="사유" Width="150" DisplayMemberBinding="{Binding Reason}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="선택 파일 복원" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnRestoreQuarantineClick"/>
                                <Button Content="영구 삭제" Style="{StaticResource DangerButton}" Click="OnDeleteQuarantineClick"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 7. SANDBOX LAUNCHER VIEW -->
                <Border x:Name="ViewSandbox" Visibility="Collapsed" Background="#121B29" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="22">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="제로트러스트 격리 실행기 (게임 런처 · 외부 파일 전용)" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="공식 게임 런처나 외부 프로그램이 공급망 공격에 당하더라도 실제 Chrome 쿠키/비밀번호, .ssh, .aws, 가상자산 지갑에 접근하지 못하도록 분리된 프로필(USERPROFILE/APPDATA/TEMP) 또는 Windows Sandbox 가상머신에서 실행합니다."
                                   Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,6,0,18"/>

                        <TextBlock Text="실행할 프로그램 (.exe)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SandboxExePathBox" Background="#080D15" Foreground="#F1F5F9" BorderBrush="#334155" Padding="10,8"/>
                            <Button Grid.Column="1" Content="파일 찾기..." Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnBrowseSandboxExeClick"/>
                        </Grid>

                        <TextBlock Text="추가 실행 인자 (선택)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="SandboxArgsBox" Background="#080D15" Foreground="#F1F5F9" BorderBrush="#334155" Padding="10,8" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="격리 프로필 환경에서 실행 (Job Object)" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="OnLaunchIsolatedClick"/>
                            <Button Content="Windows Sandbox (.wsb) 생성 및 실행" Style="{StaticResource SecondaryButton}" Click="OnLaunchWindowsSandboxClick"/>
                        </StackPanel>

                        <Border Background="#080D15" BorderBrush="#24334A" BorderThickness="1" CornerRadius="6" Padding="14">
                            <TextBlock x:Name="SandboxResultText" Text="실행 대기 중..." Foreground="#CBD5E1" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 8. KERNEL HARDENING & IOC POLICY VIEW -->
                <ScrollViewer x:Name="ViewHardening" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- OS Hardening Card -->
                        <Border Background="#121B29" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Windows 커널(Ring 0) 보안 · Enterprise ASR 규칙 · 무-UAC 부팅 자동 실행" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Microsoft 공식 서명 커널 드라이버(WdFilter.sys CFA + 5대 ASR 공격 표면 감소 규칙 + PowerShell 4104 로깅)를 결합해 진짜 Ring-0 보호를 완성합니다."
                                           Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,12"/>

                                <Border Background="#080D15" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <TextBlock x:Name="HardeningStatusSummaryText" Text="상태 조회 중..." FontFamily="Consolas" FontSize="12.5" Foreground="#E2E8F0" TextWrapping="Wrap"/>
                                </Border>

                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="상태 새로고침" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Click="OnRefreshHardeningClick"/>
                                    <Button Content="커널 CFA + ASR(저마찰 감사모드) + 4104" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" Click="OnEnableHardeningAuditClick"/>
                                    <Button Content="커널 CFA + ASR(최대보안 차단모드) + 4104" Style="{StaticResource SuccessButton}" Margin="0,0,8,6" Click="OnEnableHardeningBlockClick"/>
                                    <Button Content="자격증명(.ssh/.aws/금고) NTFS 잠금" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" Click="OnHardenAclsClick"/>
                                </WrapPanel>

                                <UniformGrid Columns="2">
                                    <Border Background="#080D15" BorderBrush="#24334A" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,8,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="일반 로그인 시 자동 실행 (Run 키)" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="UAC 승격 앱은 우측 '무-UAC 작업 스케줄러' 사용 필수" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="AutoStartCheckBox" Grid.Column="1" VerticalAlignment="Center" Content="사용" Foreground="#F1F5F9"
                                                      Checked="OnAutoStartToggled" Unchecked="OnAutoStartToggled"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="#080D15" BorderBrush="#24334A" BorderThickness="1" CornerRadius="7" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="무-UAC 관리자 자동 실행 (작업 스케줄러)" FontWeight="Bold" FontSize="13" Foreground="#38BDF8"/>
                                                <TextBlock Text="부팅 즉시 ETW 커널 텔레메트리 활성화 (권장)" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button x:Name="ElevatedTaskBtn" Grid.Column="1" VerticalAlignment="Center" Content="등록/해제" Style="{StaticResource PrimaryButton}" Padding="10,5" Click="OnToggleElevatedTaskClick"/>
                                        </Grid>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Policy & Threat Intel IOC Card -->
                        <Border Background="#121B29" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <TextBlock Text="보호 정책 · 위협 인텔리전스(IOC) 차단 목록 · VirusTotal 연동" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="보호 폴더 (랜섬웨어·카나리·엔트로피·복구금고)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox x:Name="ProtectedFoldersBox" AcceptsReturn="True" Height="100" Background="#080D15" Foreground="#F1F5F9" BorderBrush="#334155" Padding="8" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                                        <TextBlock Text="공급망 감시 런처/웹뷰 프로세스" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox x:Name="WatchedLaunchersBox" AcceptsReturn="True" Height="100" Background="#080D15" Foreground="#F1F5F9" BorderBrush="#334155" Padding="8" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                                        <TextBlock Text="화이트리스트 실행 경로" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox x:Name="WhitelistPathsBox" AcceptsReturn="True" Height="75" Background="#080D15" Foreground="#F1F5F9" BorderBrush="#334155" Padding="8" VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>

                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="IOC 차단 도메인 (한 줄에 하나 — 예: insightjs.com)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox x:Name="BlockedDomainsBox" AcceptsReturn="True" Height="80" Background="#080D15" Foreground="#F1F5F9" BorderBrush="#334155" Padding="8" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                                        <TextBlock Text="IOC 차단 IP 주소 (한 줄에 하나)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox x:Name="BlockedIpsBox" AcceptsReturn="True" Height="65" Background="#080D15" Foreground="#F1F5F9" BorderBrush="#334155" Padding="8" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                                        <TextBlock Text="IOC 차단 SHA-256 해시 (한 줄에 하나)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox x:Name="BlockedHashesBox" AcceptsReturn="True" Height="65" Background="#080D15" Foreground="#F1F5F9" BorderBrush="#334155" Padding="8" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                                        <TextBlock Text="VirusTotal API Key (선택 — 해시 전용 조회, 파일 업로드 안 함)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox x:Name="VirusTotalKeyBox" Background="#080D15" Foreground="#F1F5F9" BorderBrush="#334155" Padding="8,6"/>
                                    </StackPanel>
                                </UniformGrid>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Right">
                                    <TextBlock x:Name="ThreatFeedStatusText" Text="글로벌 위협 피드: 대기 중" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button x:Name="SyncThreatFeedsBtn" Content="글로벌 위협 피드(Abuse.ch) 즉시 동기화" Style="{StaticResource SuccessButton}" Margin="0,0,8,0" Click="OnSyncThreatFeedsClick"/>
                                    <Button Content="모든 정책 및 IOC 차단 목록 저장 · 즉시 반영" Style="{StaticResource PrimaryButton}" Click="OnSavePolicyClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Bottom Status Bar -->
            <Border Grid.Row="2" Background="#0D1420" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="18,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterMessageText" Grid.Column="0" Text="준비됨" Foreground="#94A3B8" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                               Text="창을 닫아도 시스템 트레이에서 9중 상시 방어가 계속됩니다." Foreground="#64748B" FontSize="12"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
